{
  "name": "pair",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "db:generate": "pnpm --filter @pair/db run generate",
    "db:migrate": "pnpm --filter @pair/db run migrate",
    "db:studio": "pnpm --filter @pair/db run studio"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^20.19.0",
    "prettier": "^3.4.0",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.0",
    "tsx": "^4.19.0"
  },
  "prettier": "./packages/config/prettier.config.js"
}
