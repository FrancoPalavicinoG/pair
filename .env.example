# Postgres local (ver docker-compose.yml)
DATABASE_URL=postgres://pair:pair@localhost:5433/pair

# Clave maestra de cifrado: 32 bytes en base64. Se genera una vez y se
# guarda fuera del repo — perderla significa que todos reconectan Garmin
# desde cero. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_MASTER_KEY=
